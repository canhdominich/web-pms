{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Server=localhost;Port=3306;Database=tlighthouse;User=tlighthouse;Password=tlighthouse;CharSet=utf8mb4",
    "ServerVersion": "8.0.36",
    "CreateSchemaOnStartup": true
  },
  "Jwt": {
    "Issuer": "tlighthouse-api",
    "Audience": "tlighthouse-clients",
    "RefreshAudience": "tlighthouse-refresh",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "RootEmail": "root@tlighthouse.local",
    "RootPassword": "",
    "RootFullName": "Quản trị hệ thống"
  },
  "Demo": {
    "Enabled": false,
    "SeedOnStartup": false,
    "Password": "Demo@12345"
  },
  "Jobs": {
    "OverdueIntervalMinutes": 60
  },
  "Clock": {
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "Https": {
    "Enabled": false
  }
}
